# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app and are NOT secret.
# Base URL of the Momento Planner API, including /api/v1 — e.g. your ngrok static domain:
EXPO_PUBLIC_API_URL=https://your-domain.ngrok-free.dev/api/v1
# Google Cloud "Web application" OAuth client ID (not secret). Leave empty to hide Google sign-in:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
