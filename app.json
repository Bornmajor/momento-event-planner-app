{
  "expo": {
    "name": "Momento",
    "slug": "momento",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momento",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bornmajor.momento",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "fr",
          "sw"
        ]
      }
    },
    "android": {
      "package": "com.bornmajor.momento",
      "adaptiveIcon": {
        "backgroundColor": "#EA4C89",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#111113",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fr",
              "sw"
            ],
            "android": [
              "en",
              "fr",
              "sw"
            ]
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/poppins/400Regular/Poppins_400Regular.ttf",
            "./node_modules/@expo-google-fonts/poppins/500Medium/Poppins_500Medium.ttf",
            "./node_modules/@expo-google-fonts/poppins/600SemiBold/Poppins_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/poppins/700Bold/Poppins_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Momento adds the events you choose to your calendar, with a reminder."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "38c4cbda-fa1c-4456-ac2f-196ce1671f27"
      }
    },
    "owner": "bornmaja"
  }
}
